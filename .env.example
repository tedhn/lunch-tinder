# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# --- Supabase Postgres -------------------------------------------------------
# Both strings come from Supabase: Project Settings -> Database -> Connection
# string. DATABASE_URL is the pooled connection (port 6543) used at runtime;
# DIRECT_URL is the direct one (port 5432) that migrations need, because
# Prisma migrations cannot run through pgBouncer.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Realtime (browser) ---------------------------------------------
# Project Settings -> API Keys. The publishable key is public by design; it is
# only ever used to subscribe to room/member changes. Every write goes through
# tRPC.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- App ---------------------------------------------------------------------
# How many cards land in a room's deck.
DECK_SIZE=20

# --- Google Maps Platform ----------------------------------------------------
# Optional. Leave it unset and every card falls back to its emoji; nothing else
# in the app changes. Set it and card photos come from Google Places.
#
# Enable "Places API (New)" on a billing-enabled Google Cloud project, then
# restrict the key to that one API. Both SKUs this app touches are paid per
# request: Text Search (one call per seed spot, run once via
# `bun scripts/fill-place-ids.ts`) and Place Photos (one Details + one Photo
# call per card image, cached in memory for an hour).
#
# Server-side only, deliberately un-prefixed: a NEXT_PUBLIC_ key would ship to
# every browser and bill you for whatever they do with it.
GOOGLE_MAPS_API_KEY="AIza..."

# What Google's terms allow you to keep:
# Place IDs may be stored indefinitely, and that is the only Google field this
# schema persists (`restaurant.place_id`). Everything else fetched from Places
# — names, price levels, photos — is capped at 30 days of caching, and place
# photos may not be copied into your own storage at all. That is why photos are
# proxied live through /api/place-photo/[id] rather than downloaded, and why
# `restaurant.image_url` is reserved for images you own.
